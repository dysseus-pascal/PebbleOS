menu "Watch faces"

choice
    prompt "TicToc watch face"
    default APPS_WATCH_TICTOC_ROUND if PLATFORM_GABBRO
    default APPS_WATCH_TICTOC_BW if SCREEN_COLOR_DEPTH_BITS_1
    default APPS_WATCH_TICTOC_DEFAULT
    help
      Which built-in TicToc watch face variant to build.

config APPS_WATCH_TICTOC_DEFAULT
    bool "Default (color, rectangular)"

config APPS_WATCH_TICTOC_BW
    bool "Black and white (1-bit)"

config APPS_WATCH_TICTOC_ROUND
    bool "Round"

endchoice

# Boulder: TimeStyle (freakified/TimeStylePebble, MIT) as a system watch face,
# with the weather from the weather service instead of PebbleKit JS. Laid out
# for the rectangular color screen of emery only.
config APPS_WATCH_TIMESTYLE
    bool "TimeStyle watch face"
    default y
    depends on PLATFORM_EMERY && SERVICE_WEATHER && SERVICE_ACTIVITY
    help
      TimeStyle as a built-in watch face and the default one, with a fixed
      configuration (weather, steps, date in the sidebar).

endmenu
